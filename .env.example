# =========================================================================
# Central de Dados — Grande Estratégia
# -------------------------------------------------------------------------
# Copie este arquivo para `.env` (na raiz do projeto) e preencha os valores.
# As variáveis precisam começar com VITE_ para serem expostas ao navegador
# pelo Vite via import.meta.env.
#
# Onde achar as chaves:
#   Supabase Dashboard -> seu projeto -> Settings -> API
# =========================================================================

# URL base do projeto Supabase (já preenchida com o projeto atual)
VITE_SUPABASE_URL=https://cxaripmskrtlwrgnynhm.supabase.co

# Chave PUBLISHABLE (recomendada — formato sb_publishable_...)
# Use esta OU a anon legacy abaixo. Se ambas estiverem preenchidas, a publishable vence.
VITE_SUPABASE_PUBLISHABLE_KEY=

# Chave ANON legacy (JWT). Use apenas se ainda não tiver a publishable key.
VITE_SUPABASE_ANON_KEY=

# Schema do ForestOS no banco. Não altere a menos que você renomeie no DB.
# IMPORTANTE: este schema precisa estar listado em
#   Supabase Dashboard -> Project Settings -> API -> Exposed schemas
# senão o PostgREST devolverá 404 para todas as queries.
VITE_FORESTOS_SCHEMA=forestos
